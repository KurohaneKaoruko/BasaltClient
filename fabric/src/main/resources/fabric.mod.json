{
	"schemaVersion": 1,
	"id": "basalt-client",
	"version": "${version}",
	"name": "玄武岩CLIENT",
	"description": "拥有多项辅助功能的客户端模组。",
	"authors": [
		"Kaoruko"
	],
	"contact": {
		"sources": "https://github.com/kurohanekaoruko/BasaltClient",
		"issues": "https://github.com/kurohanekaoruko/BasaltClient/issues"
	},
	"icon": "assets/basalt-client/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"mc.basalt.client.platform.fabric.FabricPlatform"
		]
	},
	"accessWidener": "basalt-client.accesswidener",
	"mixins": [
		"basalt-client.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
